# Copy to .env. Never commit .env. Compose overrides DATABASE_URL internally.
DATABASE_URL=sqlite:///./data/jobs.db
POSTGRES_DB=jobs
POSTGRES_USER=jobs
POSTGRES_PASSWORD=change-this-local-password
WEB_PORT=3000
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLED_SOURCES=104,1111,cake,linkedin,indeed
COLLECT_KEYWORDS=Data Scientist,資料科學,Data Analyst,Data Engineer,Machine Learning,AI 工程師,前端工程師,後端工程師,全端工程師,軟體工程師,DevOps,SRE
COLLECT_LOCATION=Taiwan
COLLECT_ON_STARTUP=true
SCHEDULE_TIMEZONE=Asia/Taipei
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=0
MAX_RESULTS_PER_KEYWORD=100
MAX_PAGES_PER_KEYWORD=10
REQUEST_DELAY_SECONDS=2
REQUEST_TIMEOUT_SECONDS=30
REQUEST_RETRIES=2
SOURCE_TIMEOUT_SECONDS=1800
WORKER_LOCK_SECONDS=120
STATUS_STALE_DAYS=7
# JSON maps override only listed sources; others use the global setting.
SOURCE_REQUEST_DELAYS={"linkedin":30,"cake":10}
BATCH_PAGES_PER_RUN=6
SOURCE_REQUEST_TIMEOUTS={}
SOURCE_TIMEOUTS={"linkedin":3600}
LINKEDIN_DETAIL_LIMIT=20
LINKEDIN_DETAIL_REFRESH_DAYS=7
RATE_LIMIT_COOLDOWN_SECONDS=3600
BLOCKED_COOLDOWN_SECONDS=86400
SOURCE_DIAGNOSTICS=true
DIAGNOSTICS_DIRECTORY=data/diagnostics
DIAGNOSTICS_MAX_EVENTS=100
# Only public frontend configuration belongs in VITE_ variables.
VITE_API_BASE_URL=/api/v1
